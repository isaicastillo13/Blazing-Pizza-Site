@page "/pizzas"
@using BlazingPizza.Data
@inject PizzaService PizzaSvc

<section class="main pizzas-page">
    <div class="container pizzas-container">
        <div class="text-center mb-4">
            <p class="hero-kicker">Menu del dia</p>
            <h1>Choose your pizza</h1>
            <p class="text-muted">We have all these delicious recipes:</p>
        </div>

        @if(todaysPizzas == null ){
            <div class="text-center loading-card">
                <em>Loading...</em>
            </div>
        }else{
            <div class="table-responsive menu-card shadow-sm">
                <table class="table table-striped table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Price</th>
                            <th>Vegetarian</th>
                            <th>Vegan</th>
                        </tr>
                    </thead>
                    <tbody>
                @foreach (var pizza in todaysPizzas){
                    <tr>
                        <td class="font-weight-bold">@pizza.Name</td>
                        <td>@pizza.Description</td>
                        <td>@pizza.Price.ToString("C")</td>
                        <td>@pizza.Vegetarian</td>
                        <td>@pizza.Vegan</td>
                    </tr>
                }
                </tbody>
                </table>
            </div>
        }
    </div>
</section>


@code {
   private List<BlazingPizza.Data.Pizza> todaysPizzas = null!;

protected override async Task OnInitializedAsync()
{
    todaysPizzas = await PizzaSvc.GetPizzasAsync();
}
}
